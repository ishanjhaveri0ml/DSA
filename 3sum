class Solution(object):
    def threeSum(self, nums):
        res = set()

        n, p, z = [], [], []
        for num in nums:
            if num > 0:
                p.append(num)
            elif num < 0:
                n.append(num)
            else:
                z.append(num)

        N, P = set(n), set(p)

        # Case 1: Triplet with zero in the middle
        if z:
            for num in P:
                if -1 * num in N:
                    res.add((-1 * num, 0, num))

        # Case 2: Three zeroes
        if len(z) >= 3:
            res.add((0, 0, 0))

        # Case 3: Two negatives and one positive
        for i in range(len(n)):
            for j in range(i + 1, len(n)):
                target = -1 * (n[i] + n[j])
                if target in P:
                    res.add(tuple(sorted([n[i], n[j], target])))

        # Case 4: Two positives and one negative
        for i in range(len(p)):
            for j in range(i + 1, len(p)):
                target = -1 * (p[i] + p[j])
                if target in N:
                    res.add(tuple(sorted([p[i], p[j], target])))

        # Convert result to list of lists
        return [list(triplet) for triplet in res]
